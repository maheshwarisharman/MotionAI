# ───────────────────────────────────────────────────────────────────────────
# MotionAI Backend — Environment Variables
# Copy this file to .env and fill in all values before running the server.
# ───────────────────────────────────────────────────────────────────────────

# TCP port the Express server will listen on
PORT=3000

# Redis connection URL used by BullMQ (e.g. redis://localhost:6379)
REDIS_URL=redis://localhost:6379

# ─── AWS Credentials ────────────────────────────────────────────────────────

# AWS IAM access key ID (must have s3:PutObject and s3:GetObject permissions)
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here

# AWS IAM secret access key
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here

# S3 bucket name where rendered MP4 files will be stored
AWS_S3_BUCKET=your-motionai-bucket-name

# AWS region where the S3 bucket is located (e.g. us-east-1)
AWS_REGION=us-east-1

# ─── Google Gemini ───────────────────────────────────────────────────────────

# Google Gemini API key (obtain from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Render Settings ─────────────────────────────────────────────────────────

# Maximum number of Remotion render jobs to process simultaneously
MAX_RENDER_CONCURRENT=2

# ─── Application ─────────────────────────────────────────────────────────────

# Node.js environment: development | production | test
NODE_ENV=development

# Local directory used as scratch space during rendering (created automatically)
TEMP_DIR=/tmp/motionai
